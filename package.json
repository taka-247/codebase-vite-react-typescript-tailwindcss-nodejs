{
  "name": "react-vite-codebase",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "share": "npm run build --workspace=shared",
    "dev": "npm run share && run-p dev:*",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "npm-run-all2": "^9.0.1"
  }
}
