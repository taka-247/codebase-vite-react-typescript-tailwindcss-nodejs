{
    "name": "react-vite-codebase",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "workspaces": [
        "frontend",
        "backend",
        "shared"
    ],
    "scripts": {
        "share": "npm run build --workspace=shared",
        "dev": "npm run build --workspace=shared && concurrently \"npm run dev --workspace=frontend\" \"npm run dev --workspace=backend\""
    },
    "devDependencies": {
        "concurrently": "^10.0.3"
    }
}
