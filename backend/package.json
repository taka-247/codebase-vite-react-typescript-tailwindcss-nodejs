{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "migrate": "run-s migrate:*",
    "migrate:init": "test -f supabase/config.toml || supabase init",
    "migrate:login": "supabase projects list > /dev/null 2>&1 || supabase login",
    "migrateInitial": "npm run migrate && npm run migrateLink",
    "migrateLink": "dotenv -- supabase link --project-ref $SUPABASE_PROJECT_REF",
    "migrateUpdate": "npm run migrate && npm run migratePush",
    "migratePush": "dotenv -- supabase db push",
    "migrateNew": "supabase migration new"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@app/shared": "^1.0.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/supertest": "^7.2.0",
    "@vitest/ui": "^4.1.8",
    "dotenv-cli": "^11.0.0",
    "npm-run-all2": "^9.0.2",
    "supabase": "^2.108.0",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
